generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MinistryStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  Int                     @id @default(autoincrement())
  name                String
  email               String                  @unique
  password            String

  role                Role      @default(MEMBER)

  faceDescriptor      String?                 @db.Text // Stores 128-dimensional face descriptor as JSON string
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  attendances         AttendanceInformation[]
  devotions           Devotion[]
  mentees             DiscipleInformation[]   @relation("Mentor")
  discipleInformation DiscipleInformation?
  organizedActivities MinistryActivities[]    @relation("Organizer")
  assignedOutreaches  Outreach[]              @relation("AssignedPastor")
  personalInformation PersonalInformation?
  trainings           Training[]
  ministryMemberships MinistryMember[]
  comments            DevotionComment[]
  likes               DevotionLike[]
  createdEvents       Event[]                 @relation("EventCreator")
  eventJoins          EventAttendee[]
  eventAttendances    EventAttendance[]       @relation("EventAttendance")

  @@map("users")
}

enum Role {
  ADMIN
  MEMBER
}

model PersonalInformation {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  firstName    String?
  middleName   String?
  lastName     String?
  phone        String?
  birthday     DateTime? @db.Date
  gender       String?
  houseNumber  String? 
  city         String?
  barangay     String? 
  country      String?
  bio          String?
  profileImage String?  @map("profileImage")  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personal_information")
}

model DiscipleInformation {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  level      String    @default("disciple")
  mentorId   Int?
  groupName  String?
  joinedDate DateTime?
  outreachId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  mentor     User?     @relation("Mentor", fields: [mentorId], references: [id])
  outreach   Outreach? @relation(fields: [outreachId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disciple_information")
}

model Devotion {
  id                 Int      @id @default(autoincrement())
  userId             Int
  title              String
  content            String
  image              String 
  scriptureReference String?
  devotionDate       DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments           DevotionComment[]
  likes              DevotionLike[]

  @@map("devotions")
}

model DevotionComment {
  id         Int       @id @default(autoincrement())

  userId     Int
  devotionId Int

  comment    String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotion   Devotion  @relation(fields: [devotionId], references: [id], onDelete: Cascade)

  @@index([devotionId])
  @@index([userId])

  @@map("devotion_comments")
}

model DevotionLike {
  id         Int @id @default(autoincrement())

  userId     Int
  devotionId Int

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotion   Devotion @relation(fields: [devotionId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, devotionId]) // prevents double-like
  @@map("devotion_likes")
}

model TrainingCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  type      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  trainings Training[]

  @@map("training_category")
}

model Training {
  id               Int                     @id @default(autoincrement())
  userId           Int
  title            String
  description      String
  trainerName      String?
  trainingDate     DateTime
  completionStatus MinistryStatus          @default(PENDING)
  categoryId       Int?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  attendances      AttendanceInformation[]
  category         TrainingCategory?       @relation(fields: [categoryId], references: [id])
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trainings")
}

model MinistryActivities {
  id           Int                     @id @default(autoincrement())
  title        String
  date         DateTime
  isRegular    Boolean                 @default(false)
  organizerId  Int
  place        String?
  outreachId   Int?
  scheduleType String                  @default("daily")
  weekdays     String?
  monthlyDates String?
  yearlyDates  String?
  startTime    DateTime?
  endTime      DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  attendances  AttendanceInformation[]
  organizer    User                    @relation("Organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  outreach     Outreach?               @relation(fields: [outreachId], references: [id])

  @@map("ministry_activities")
}

model Ministry {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     MinistryMember[]
  trainings   MinistryTraining[]

  @@map("ministries")
}

model MinistryMember {
  id         Int      @id @default(autoincrement())

  userId     Int
  ministryId Int

  status     MinistryStatus   @default(PENDING)
  role       String?

  joinedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  completions MinistryTrainingCompletion[]

  @@unique([userId, ministryId])

  @@index([ministryId])   // ⭐ add
  @@index([userId])       // ⭐ add
  @@index([status])       // ⭐ add

  @@map("ministry_members")
}

model MinistryTraining {
  id          Int      @id @default(autoincrement())
  ministryId  Int
  title       String
  description String?

  ministry    Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  completions MinistryTrainingCompletion[]

  createdAt   DateTime @default(now())

  @@map("ministry_trainings")
}

model MinistryTrainingCompletion {
  id                Int      @id @default(autoincrement())

  ministryMemberId  Int
  trainingId        Int

  completed         Boolean  @default(false)
  completedAt       DateTime?

  member            MinistryMember @relation(fields: [ministryMemberId], references: [id], onDelete: Cascade)
  training          MinistryTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([ministryMemberId, trainingId])

  @@index([ministryMemberId])   // ⭐ add
  @@index([trainingId])         // ⭐ add

  @@map("ministry_training_completions")
}

model AttendanceInformation {
  id                 Int                @id @default(autoincrement())
  userId             Int
  date               DateTime           @db.Date
  timeIn             DateTime
  isPresent          Boolean            @default(true)
  ministryActivityId Int
  ministryType       String
  trainingId         Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  ministryActivity   MinistryActivities @relation(fields: [ministryActivityId], references: [id], onDelete: Cascade)
  training           Training?          @relation(fields: [trainingId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendance_information")
}

model Outreach {
  id             Int                   @id @default(autoincrement())
  name           String
  assignedPastor Int
  location       String
  yearStart      Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  disciples      DiscipleInformation[]
  activities     MinistryActivities[]
  pastor         User                  @relation("AssignedPastor", fields: [assignedPastor], references: [id], onDelete: Cascade)

  @@map("outreach")
}

model Event {
  id          Int      @id @default(autoincrement())

  // creator
  creatorId   Int
  creator     User     @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // event info
  title       String
  description String?
  image       String?   // poster URL/path
  location    String   @default("TBD")
  locationLatitude  Float?   // For geolocation verification
  locationLongitude Float?   // For geolocation verification
  locationRadius    Float?   @default(100) // Radius in meters for geolocation check

  // schedule
  start       DateTime
  end         DateTime

  // recurring event settings
  isRegular   Boolean  @default(false)
  recurrence  String?  // daily, weekly, monthly, yearly

  // relations
  attendees   EventAttendee[]
  attendances EventAttendance[] @relation("EventAttendance")

  //
  allowRegistration Boolean @default(false) 

  color       String   @default("blue") 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@map("events")
}

model EventAttendee {
  id        Int      @id @default(autoincrement())

  eventId   Int
  userId    Int

  // optional tracking (very useful later)
  joinedAt  DateTime @default(now())
  status    String   @default("joined") // joined | cancelled | attended

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId]) // prevent duplicate joins
  @@index([userId])
  @@map("event_attendees")
}

model EventAttendance {
  id         Int      @id @default(autoincrement())

  userId     Int
  eventId    Int

  date       DateTime @db.Date
  timeIn     DateTime
  isPresent  Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation("EventAttendance", fields: [userId], references: [id], onDelete: Cascade)
  event      Event    @relation("EventAttendance", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([date])
  @@map("event_attendance")
}
